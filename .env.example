# TMDB credentials — create a free key at https://www.themoviedb.org/settings/api
# Preferred: API Read Access Token (v4)
TMDB_READ_TOKEN=
# Optional fallback: API Key (v3)
TMDB_API_KEY=

# Public site URL, used for canonical links, sitemap and social metadata
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Optional contact shown on the legal page
NEXT_PUBLIC_CONTACT_EMAIL=
